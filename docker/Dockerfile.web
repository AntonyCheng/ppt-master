FROM node:22-bookworm-slim AS frontend-build

WORKDIR /build
COPY webapp/frontend/package.json ./
RUN npm install
COPY webapp/frontend ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app/webapp
RUN python -m venv /opt/venv
COPY webapp/requirements.txt /tmp/webapp-requirements.txt
RUN pip install --no-cache-dir -r /tmp/webapp-requirements.txt
COPY webapp/api ./api
COPY webapp/runner ./runner
COPY webapp/migrations ./migrations
COPY webapp/alembic.ini ./alembic.ini
COPY --from=frontend-build /build/dist ./frontend/dist
COPY docker/bin/start-web.sh /usr/local/bin/start-web
RUN useradd --create-home --uid 10001 pptmaster \
    && chmod +x /usr/local/bin/start-web \
    && chown -R pptmaster:pptmaster /app/webapp
USER pptmaster

CMD ["start-web"]
