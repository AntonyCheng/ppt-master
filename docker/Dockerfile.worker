FROM ghcr.io/anomalyco/opencode:1.18.18@sha256:f3e00f8e25500150373c817e24b13f2f08e2ccd4cafd53dc3ad4827d47863b6f AS opencode

FROM python:3.12-slim

# Mirrors the matching Debian and Debian Security paths while retaining Debian's package signatures.
ARG APT_MIRROR=https://mirrors.aliyun.com/debian
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    HOME=/home/pptmaster

WORKDIR /app
RUN sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash build-essential ca-certificates curl fd-find ffmpeg findutils fontconfig \
        fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji git jq libstdc++6 \
        openssh-client pandoc pkg-config procps psmisc ripgrep tini unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd
# The official image ships a musl-linked executable. Carry its small runtime
# closure into Debian rather than relying on incompatible system libraries.
COPY --from=opencode /lib/ld-musl-x86_64.so.1 /lib/ld-musl-x86_64.so.1
COPY --from=opencode /usr/lib/libstdc++.so.6 /usr/lib/libstdc++.so.6
COPY --from=opencode /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1
COPY --from=opencode /usr/local/bin/opencode /usr/local/bin/opencode
COPY requirements.txt ./requirements.txt
COPY AGENTS.md ./AGENTS.md
COPY docs/rules ./docs/rules
COPY skills ./skills
RUN opencode --version
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.txt \
    && useradd --create-home --uid 10003 pptmaster \
    && mkdir -p /opt/pptmaster/opencode-config /workspace/project \
    && chown -R pptmaster:pptmaster /app /workspace
COPY --chown=pptmaster:pptmaster webapp/worker ./worker
USER pptmaster

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "worker.main"]
